{
  "name": "radiographer-exam-bank",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "dev": "npm run build:data && vite",
    "build:data": "node scripts/bounded-run.mjs 300 node scripts/build-question-data.mjs",
    "build": "node scripts/bounded-run.mjs 600 npm run build:unbounded",
    "preview": "vite preview",
    "test": "node scripts/bounded-run.mjs 240 node --test tests/*.test.mjs",
    "check": "node scripts/check-source.mjs && npm test",
    "build:unbounded": "npm run build:data && vite build",
    "import:official": "node scripts/bounded-run.mjs 300 python3 scripts/import-moex.py",
    "update:official": "node scripts/bounded-run.mjs 600 python3 scripts/scheduled-moex-update.py",
    "watch:official": "python3 scripts/scheduled-moex-update.py --watch"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.11"
  }
}
